{
	"sap.app": {
		"id": "com.ndbs.skillreportingui.cards.topSkills",
		"type": "card",
		"title": "Skills"
	},
	"sap.card": {
		"type": "List",
		"header": {
			"title": "{0/cardTitle}",
			"subTitle": "{0/cardSubtitle}",
			"icon": { "src": "sap-icon://competitor" },
			"actions": [{ "type": "Navigation", "parameters": { "url": "#/skills" } }]
		},
		"data": {
			"request": {
				"url": "/api/dashboard/topSkills()"
			},
			"path": "/value"
		},
		"content": {
			"item": {
				"title": "{skillName}",
				"description": "{description}",
				"icon": { "src": "{imageUrl}" },
				"actions": [{ "type": "Navigation", "parameters": { "url": "#/employee-skills" } }]
			}
		}
	}
}
