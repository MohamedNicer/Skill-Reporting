<mvc:View
    controllerName="com.ndbs.skillreportingui.controller.Homepage"
    xmlns:mvc="sap.ui.core.mvc"
    displayBlock="true"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:smartTable="sap.ui.comp.smarttable"
    xmlns:smartFilterBar="sap.ui.comp.smartfilterbar"
    xmlns:w="sap.ui.integration.widgets"
    xmlns:grid="sap.ui.layout.cssgrid"
>
    <Page id="Homepage" showHeader="false">
        <IconTabBar id="itbLaunchpad" class="sapUiNoContentPadding" headerBackgroundDesign="Solid" applyContentPadding="false" select=".onTabSelect">
            <items>
                <!-- Overview: Cards Dashboard -->
                <IconTabFilter text="{i18n>overview}" key="overview">
                    <VBox class="sapUiMediumMarginTop sapUiSmallMarginBeginEnd">
                        <grid:CSSGrid class="gridAlignStart" gridGap="1rem" gridTemplateColumns="repeat(auto-fit, minmax(22rem, 1fr))">
                            <grid:items>
                                <w:Card id="cardKpi" manifest="./cards/kpi/manifest.json">
                                    <w:layoutData>
                                        <grid:GridItemLayoutData gridColumn="span 1" />
                                    </w:layoutData>
                                </w:Card>

                                <w:Card manifest="./cards/assignments/manifest.json">
                                    <w:layoutData>
                                        <grid:GridItemLayoutData gridColumn="span 2" />
                                    </w:layoutData>
                                </w:Card>

                                <w:Card manifest="./cards/requests/manifest.json" visible="{= ${userRolesModel>/isAdmin}}">
                                    <w:layoutData>
                                        <grid:GridItemLayoutData gridColumn="span 2" />
                                    </w:layoutData>
                                </w:Card>

                                <w:Card manifest="./cards/topSkills/manifest.json">
                                    <w:layoutData>
                                        <grid:GridItemLayoutData gridColumn="span 1" />
                                    </w:layoutData>
                                </w:Card>

                                <w:Card manifest="./cards/skillsByCategory/manifest.json">
                                    <w:layoutData>
                                        <grid:GridItemLayoutData gridColumn="span 2" gridRow="span 2" />
                                    </w:layoutData>
                                </w:Card>

                                <w:Card manifest="./cards/requestsStatus/manifest.json" visible="{= ${userRolesModel>/isAdmin}}">
                                    <w:layoutData>
                                        <grid:GridItemLayoutData gridColumn="span 1" />
                                    </w:layoutData>
                                </w:Card>
                            </grid:items>
                        </grid:CSSGrid>
                    </VBox>
                </IconTabFilter>

                <!-- My Workspace (Employee) -->
                <IconTabFilter text="My Workspace" key="my_workspace">
                    <VBox class="sapUiMediumMargin">

                        <!-- Section: My Skills -->
                        <Title text="My Skills" level="H4" class="section-title sapUiSmallMarginBottom" />
                        <HBox wrap="Wrap" class="sapUiTinyMarginBottom">
                            <!-- My Skills tile — CLICKABLE -->
                            <GenericTile
                                id="tileMySkills"
                                header="My Skills"
                                subheader="View &amp; update my profile skills"
                                press=".onNavToView('RouteEmployeeSkills')"
                                class="sapUiSmallMarginEnd sapUiSmallMarginBottom"
                            >
                                <TileContent>
                                    <NumericContent value="{dashboardModel>/employeeSkills}" icon="sap-icon://employee-approvals" valueColor="Good" />
                                </TileContent>
                            </GenericTile>

                            <!-- Skills by Category tile — CLICKABLE (redirects to My Skills) -->
                            <GenericTile
                                id="tileMySkillsByCategory"
                                header="Skills by Category"
                                subheader="My skills grouped by category"
                                press=".onNavToView('RouteEmployeeSkills')"
                                class="sapUiSmallMarginEnd sapUiSmallMarginBottom"
                            >
                                <TileContent>
                                    <ImageContent src="sap-icon://pie-chart" />
                                </TileContent>
                            </GenericTile>
                        </HBox>

                        <!-- Section: My Requests -->
                        <Title text="My Requests" level="H4" class="section-title sapUiSmallMarginBottom sapUiMediumMarginTop" />
                        <HBox wrap="Wrap" class="sapUiTinyMarginBottom">
                            <!-- Skill Requests tile — CLICKABLE (redirects to my requests) -->
                            <GenericTile
                                id="tileMyRequests"
                                header="My Skill Requests"
                                subheader="Track my submitted skill requests"
                                press=".onNavToView('RouteSkillRequests')"
                                class="sapUiSmallMarginEnd sapUiSmallMarginBottom"
                            >
                                <TileContent>
                                    <NumericContent value="{dashboardModel>/pendingRequests}" icon="sap-icon://message-popup" valueColor="{= ${dashboardModel>/pendingRequests} > 0 ? 'Critical' : 'Good' }" />
                                </TileContent>
                            </GenericTile>
                        </HBox>

                        <!-- Section: My CVs -->
                        <Title text="My CVs" level="H4" class="section-title sapUiSmallMarginBottom sapUiMediumMarginTop" />
                        <HBox wrap="Wrap" class="sapUiTinyMarginBottom">
                            <!-- Uploaded CVs tile — NOT clickable for employee -->
                            <GenericTile
                                id="tileUploadedCVs"
                                header="{i18n>uploadedCVs}"
                                subheader="{i18n>manageUploadedCVs}"
                                class="sapUiSmallMarginEnd sapUiSmallMarginBottom"
                                state="Disabled"
                            >
                                <TileContent>
                                    <ImageContent src="sap-icon://upload-to-cloud" />
                                </TileContent>
                            </GenericTile>

                            <!-- Generated CVs tile — NOT clickable for employee -->
                            <GenericTile
                                id="tileGeneratedCVs"
                                header="{i18n>generatedCVs}"
                                subheader="{i18n>manageGeneratedCVs}"
                                class="sapUiSmallMarginEnd sapUiSmallMarginBottom"
                                state="Disabled"
                            >
                                <TileContent>
                                    <ImageContent src="sap-icon://pdf-attachment" />
                                </TileContent>
                            </GenericTile>
                        </HBox>
                    </VBox>
                </IconTabFilter>

                <!-- Manager Workspace — only visible to managers and above -->
                <IconTabFilter text="Manager Workspace" key="manager_workspace" visible="{= ${userRolesModel>/isManagerOrAbove}}">
                    <VBox class="sapUiMediumMargin">

                        <!-- Section: My Team -->
                        <Title text="My Team" level="H4" class="section-title sapUiSmallMarginBottom" />
                        <HBox wrap="Wrap" class="sapUiTinyMarginBottom">
                            <!-- Team Skills — CLICKABLE -->
                            <GenericTile
                                id="tileTeamSkills"
                                header="Team Skills Overview"
                                subheader="View &amp; endorse team member skills"
                                press=".onNavToView('RouteTeamSkills')"
                                class="sapUiSmallMarginEnd sapUiSmallMarginBottom"
                            >
                                <TileContent>
                                    <ImageContent src="sap-icon://manager" />
                                </TileContent>
                            </GenericTile>

                            <!-- Personnel Directory — CLICKABLE -->
                            <GenericTile
                                id="tilePersonnel"
                                header="Personnel Directory"
                                subheader="Browse &amp; manage employee profiles"
                                press=".onNavToView('RoutePersonnel')"
                                class="sapUiSmallMarginEnd sapUiSmallMarginBottom"
                            >
                                <TileContent>
                                    <NumericContent value="{dashboardModel>/employees}" icon="sap-icon://company-view" valueColor="Good" />
                                </TileContent>
                            </GenericTile>

                            <!-- Skill Catalog — CLICKABLE -->
                            <GenericTile
                                id="tileSkillCatalog"
                                header="Skill Catalog"
                                subheader="Browse &amp; manage approved skills"
                                press=".onNavToView('RouteSkills')"
                                class="sapUiSmallMarginEnd sapUiSmallMarginBottom"
                            >
                                <TileContent>
                                    <NumericContent value="{dashboardModel>/skills}" icon="sap-icon://education" valueColor="Neutral" />
                                </TileContent>
                            </GenericTile>
                        </HBox>

                        <!-- Section: Team Analytics -->
                        <Title text="Team Analytics" level="H4" class="section-title sapUiSmallMarginBottom sapUiMediumMarginTop" />
                        <HBox wrap="Wrap" class="sapUiTinyMarginBottom">
                            <!-- Department Heatmap — CLICKABLE -->
                            <GenericTile
                                id="tileDeptHeatmap"
                                header="Department Skills Heatmap"
                                subheader="Visualise skill gaps across departments"
                                press=".onNavToView('RouteDepartmentHeatmap')"
                                class="sapUiSmallMarginEnd sapUiSmallMarginBottom"
                            >
                                <TileContent>
                                    <ImageContent src="sap-icon://business-objects-experience" />
                                </TileContent>
                            </GenericTile>

                            <!-- CV Activity — CLICKABLE -->
                            <GenericTile
                                id="tileCVActivity"
                                header="CV Activity Log"
                                subheader="Track CV uploads &amp; generation activity"
                                press=".onNavToView('RouteCVActivity')"
                                class="sapUiSmallMarginEnd sapUiSmallMarginBottom"
                            >
                                <TileContent>
                                    <ImageContent src="sap-icon://activity-2" />
                                </TileContent>
                            </GenericTile>
                        </HBox>

                        <!-- Section: Skill Requests (as manager) -->
                        <Title text="Skill Requests" level="H4" class="section-title sapUiSmallMarginBottom sapUiMediumMarginTop" />
                        <HBox wrap="Wrap" class="sapUiTinyMarginBottom">
                            <!-- Pending Skill Requests — CLICKABLE -->
                            <GenericTile
                                id="tilePendingRequests"
                                header="Pending Skill Requests"
                                subheader="Review all employee skill requests"
                                press=".onNavToView('RouteSkillRequests')"
                                class="sapUiSmallMarginEnd sapUiSmallMarginBottom"
                            >
                                <TileContent>
                                    <NumericContent value="{dashboardModel>/pendingRequests}" indicator="{= ${dashboardModel>/pendingRequests} > 0 ? 'Up' : 'None' }" icon="sap-icon://message-popup" valueColor="{= ${dashboardModel>/pendingRequests} > 0 ? 'Critical' : 'Good' }" />
                                </TileContent>
                            </GenericTile>
                        </HBox>

                        <!-- Section: Manager's Own Profile -->
                        <Title text="My Profile (as Employee)" level="H4" class="section-title sapUiSmallMarginBottom sapUiMediumMarginTop" />
                        <HBox wrap="Wrap" class="sapUiTinyMarginBottom">
                            <!-- My Skills — CLICKABLE (manager is also employee) -->
                            <GenericTile
                                id="tileMgrMySkills"
                                header="My Own Skills"
                                subheader="Manage my personal skill profile"
                                press=".onNavToView('RouteEmployeeSkills')"
                                class="sapUiSmallMarginEnd sapUiSmallMarginBottom"
                            >
                                <TileContent>
                                    <NumericContent value="{dashboardModel>/employeeSkills}" icon="sap-icon://employee-approvals" valueColor="Good" />
                                </TileContent>
                            </GenericTile>

                            <!-- My Skill Requests — CLICKABLE -->
                            <GenericTile
                                id="tileMgrMyRequests"
                                header="My Skill Requests"
                                subheader="Track my own submitted skill requests"
                                press=".onNavToView('RouteSkillRequests')"
                                class="sapUiSmallMarginEnd sapUiSmallMarginBottom"
                            >
                                <TileContent>
                                    <ImageContent src="sap-icon://request" />
                                </TileContent>
                            </GenericTile>
                        </HBox>
                    </VBox>
                </IconTabFilter>

                <!-- Administration -->
                <IconTabFilter text="{i18n>administration}" key="administration" visible="{= ${userRolesModel>/isAdmin} || ${userRolesModel>/Auditor}}">
                    <HBox class="sapUiMediumMargin" wrap="Wrap">
                        <GenericTile
                            header="{i18n>skillCategories}"
                            subheader="{i18n>systemSettings}"
                            press=".onNavToView('RouteSkillCategories')"
                            class="sapUiSmallMarginEnd sapUiSmallMarginBottom"
                        >
                            <TileContent>
                                <ImageContent src="sap-icon://list" />
                            </TileContent>
                        </GenericTile>

                        <GenericTile
                            header="{i18n>proficiencyLevels}"
                            subheader="{i18n>systemSettings}"
                            press=".onNavToView('RouteProficiencyLevels')"
                            class="sapUiSmallMarginEnd sapUiSmallMarginBottom"
                        >
                            <TileContent>
                                <ImageContent src="sap-icon://measure" />
                            </TileContent>
                        </GenericTile>

                        <GenericTile
                            header="{i18n>skillRequests}"
                            subheader="{i18n>systemSettings}"
                            press=".onNavToView('RouteSkillRequests')"
                            class="sapUiSmallMarginEnd sapUiSmallMarginBottom"
                        >
                            <TileContent>
                                <NumericContent value="{dashboardModel>/pendingRequests}" indicator="{= ${dashboardModel>/pendingRequests} > 0 ? 'Up' : 'None' }" icon="sap-icon://message-popup" valueColor="{= ${dashboardModel>/pendingRequests} > 0 ? 'Critical' : 'Good' }" />
                            </TileContent>
                        </GenericTile>

                        <GenericTile
                            header="Audit Events"
                            subheader="Security &amp; Audit Trail"
                            press=".onNavToView('RouteAuditLog')"
                            class="sapUiSmallMarginEnd sapUiSmallMarginBottom"
                        >
                            <TileContent>
                                <ImageContent src="sap-icon://audit" />
                            </TileContent>
                        </GenericTile>
                    </HBox>
                </IconTabFilter>
            </items>
        </IconTabBar>
        <footer>
            <OverflowToolbar id="otbFooter">
                <Button
                    id="btnMessages"
                    icon="sap-icon://alert"
                    text="{=${message>/}.length}"
                    type="Emphasized"
                    press="onMessagePopoverPress"
                />
            </OverflowToolbar>
        </footer>
    </Page>
</mvc:View>
